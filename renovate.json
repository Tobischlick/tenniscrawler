{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":timezone(Europe/Berlin)"
  ],
  "minimumReleaseAge": "3 days",
  "pip-compile": {
    "managerFilePatterns": [
      "/(^|/)requirements(-dev)?\\.txt$/"
    ]
  },
  "pip_requirements": {
    "enabled": false
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "labels": [
        "dependencies"
      ]
    }
  ]
}
